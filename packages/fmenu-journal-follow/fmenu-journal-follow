#!/usr/bin/env bash

stty -echoctl
trap true SIGINT

export FZF_DEFAULT_OPTS="\
--ansi                   \
--info=inline-right      \
--scroll-off=5           \
--no-separator           \
--prompt='  '            \
--pointer=' '            \
--gutter=' '             \
--gutter-raw=' '         \
--color='fg:#969696,bg+:#04727d,fg+:#fac6c1,hl+:#d7005f,hl:#d7005f,query:#d7005f,info:#757676,gutter:-1'"

export SYSTEMD_COLORS=true
journalcmd=("journalctl" "--catalog" "--follow" "--since=00:00")

set +o errexit
while true; do
  LINE="$("${journalcmd[@]}" | fzf   \
  --tail 1000000                     \
  --wrap --wrap-sign="‣ "            \
  --layout=reverse-list              \
  --exact --track --no-sort --raw    \
  --prompt=" $USER : "               \
  --header-first                     \
  --header="alt-r : toggle raw mode | alt-down : go to bottom
suggestions: oops|error|warn|fail|timeout|critical|no-signature|tampered|audit|security|kernel:\ usb\ |missing|deprecat|ignor|vuln" \
  --bind='up:up-match,down:down-match,alt-r:toggle-raw,alt-down:last,alt-up:pos(1)'
  )"
  # --preview-window=bottom,30%,border-top,wrap \
  # --preview='bat --color always --language syslog --style plain <<< {}' \

  wl-copy           <<< "$LINE"
  wl-copy --primary <<< "$LINE"
  done
