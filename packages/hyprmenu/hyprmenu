#!/usr/bin/env bash
# set -euxo pipefail
echo "Received: '$*'" >> /tmp/rofi-debug.log
echo -en "\0message\x1fDebug: '$*'\n"
MPD_HOST="$XDG_RUNTIME_DIR/mpd/socket"
#CHOICE_POS="$ROFI_DATA"

echo -en "\0keep-selection\x1ftrue\n"
echo -en "\0keep-filter\x1ftrue\n"

case "$@" in
  # "󱙝"   ) coproc ( ~/.local/bin/scripts/hyprhidefloats       > /dev/null  2>&1 )
  #         exit;;
  "🍃"* ) hyprctl --quiet dispatch 'hl.dsp.window.float({action="toggle"})'
          dotoolc <<< "key super+space" > /dev/null  2>&1
          exit;;
  "❄"*  ) coproc { playerctl --all-players pause --no-messages
                   mpc --quiet --host="$MPD_HOST" pause    > /dev/null  2>&1 ; }
          exit;;
  # "⎔"   ) coproc ( bspc    node --to-node "$(bspc query --nodes --node    'biggest.local.leaf.!window')" --state tiled \
          # || bspc node           "$(bspc query --nodes --desktop --node .window.descendant_of)" --state tiled  > /dev/null  2>&1 )
          # exit;;
  ""   ) model="$HOME/.local/share/piper-tts/en_US-ljspeech-high.onnx"
          coproc { wl-paste --primary \
          | piper-tts --model "$model" --sentence_silence 0.3 --output_raw \
          | pw-play   --rate 21000     --channels 1 -    > /dev/null  2>&1 ;}
          exit;;
  "🌗"* ) coproc { brightnessctl --class="backlight" set 375
          busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d 1 > /dev/null 2>&1;}
          exit;;
  "🌘"* ) visual-brightness down > /dev/null  2>&1 ;;
  "🌔"* ) visual-brightness   up > /dev/null  2>&1 ;;
  "1.0x") wlr-randr --output eDP-1 --scale 1   ;;
  "1.2x") wlr-randr --output eDP-1 --scale 1.2 ;;
  "1.3x") wlr-randr --output eDP-1 --scale 1.33;;
  "1.5x") wlr-randr --output eDP-1 --scale 1.5 ;;
  "2x"  ) wlr-randr --output eDP-1 --scale 2   ;;
  "󰐳"   ) coproc qr-selectread                  > /dev/null 2>&1; exit;;
  "󰢸"*  ) coproc qr-code-from-clipboard window  > /dev/null 2>&1; exit;;
  "⏯"   ) mpc --host="$MPD_HOST" --quiet toggle > /dev/null 2>&1; exit;;
  "⏮"   ) mpc --host="$MPD_HOST" --quiet prev   > /dev/null 2>&1; exit;;
  "⏭"   ) mpc --host="$MPD_HOST" --quiet next   > /dev/null 2>&1; exit;;
  "🕪"*  ) wpctl set-volume @DEFAULT_AUDIO_SINK@ 6%+ --limit 1.8  > /dev/null  2>&1 ;;
  "🕩"*  ) wpctl set-volume @DEFAULT_AUDIO_SINK@ 6%-              > /dev/null  2>&1 ;;
  "🟦"* ) busctl --user call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n --  200 > /dev/null  2>&1 ;;
  "🟥"* ) busctl --user call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n -- -200 > /dev/null  2>&1 ;;
  "⬜"* ) busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay  Temperature q 6500 > /dev/null  2>&1 ;;
  "🎭"  ) busctl --user call rs.wl-gammarelay / rs.wl.gammarelay ToggleInverted;;
  "◎"*  ) hyprctl --quiet dispatch 'hl.dsp.window.center()'                    ;;
  "<"   ) hyprctl --quiet dispatch 'hl.dsp.group.next({ direction = "prev" })' ;;
  ">"   ) hyprctl --quiet dispatch 'hl.dsp.group.next({ direction = "next" })' ;;
  "🗄"   ) hyprctl --quiet dispatch 'hl.dsp.group.toggle()'          ; exit;;
  "󱓈"   ) hyprctl --quiet dispatch 'hl.dsp.window.kill()'           ; exit;;
  ""*  ) hyprctl --quiet dispatch 'hl.dsp.window.pin()'            ; exit;;
  "33%" ) hyprctl --quiet dispatch 'hl.dsp.layout("colresize .334")'; exit;;
  "66%" ) hyprctl --quiet dispatch 'hl.dsp.layout("colresize .664")'; exit;;
  "100%") hyprctl --quiet dispatch 'hl.dsp.layout("colresize 1")'   ; exit;;
  "50%" ) hyprctl --quiet dispatch 'hl.dsp.layout("colresize .499")'; exit;;
  "↔"   ) hyprctl --quiet dispatch "hl.dsp.window.resize({ x =  30, y = 0, relative = true })";;
  "🡒🡐"  ) hyprctl --quiet dispatch "hl.dsp.window.resize({ x = -30, y = 0, relative = true })";;
  "⤥"   ) hyprctl dispatch 'hl.dsp.layout("consume")'; exit;;
  "⤤"   ) hyprctl dispatch 'hl.dsp.layout("promote")'; exit;;
  "🪁"  ) hyprctl --quiet eval '
           hl.dispatch(hl.dsp.window.float({ action = "set" }))
           hl.dispatch(hl.dsp.window.resize({ x = "1000", y = "650", relative = false }))
           hl.dispatch(hl.dsp.window.center())
           ';;

   "🗺"   ) hyprctl --quiet eval '
             local ws = hl.get_active_workspace().id
             hl.workspace_rule({
                 workspace = tostring(ws),
                 layout = "scrolling"
             })';;

   "◨"   ) hyprctl --quiet eval '
             local ws = hl.get_active_workspace().id
             hl.workspace_rule({
                 workspace = tostring(ws),
                 layout = "master"
             })';;
   "𑁍"   ) hyprctl --quiet eval '
             local ws = hl.get_active_workspace().id
             hl.workspace_rule({
                 workspace = tostring(ws),
                 layout = "monocle"
             })';;
esac


