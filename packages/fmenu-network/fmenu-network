CAMS_IP="$(grep --only-matching --max-count=1 '[12]*[0-9][0-9]*\.[12]*[0-9][0-9]*\.[12]*[0-9][0-9]*\.[12]*[0-9][0-9]*' "$XDG_CONFIG_HOME"/sops-nix/secrets/watch_cams001)"
WLAN_DEV="$(find /sys/class/net -iname 'w*'  -printf '%f')"
WLAN_PHY="$(<    /sys/class/net/"$WLAN_DEV"/phy80211/name)"
WLAN_SERVICE="iwd.service"
source "$XDG_CONFIG_HOME"/user-dirs.dirs
# TRACKER_SERVICE=prey-agent

export  FZF_DEFAULT_OPTS="\
  --layout=reverse        \
  --ansi                  \
  --info=inline-right     \
  --no-separator          \
  --scroll-off=5          \
  --prompt='  '           \
  --pointer=' '           \
  --gutter=' '            \
  --color='bg+:#04727d,hl+:#ff497c,gutter:-1'
"

conn_dhcp(){
  # run0 ip address flush  dev "$WLAN_DEV"
  # run0 ip route   flush  dev "$WLAN_DEV"
  # run0 systemctl restart iwd.service
  iwctl station "$WLAN_DEV" scan; sleep .2

  ESSID="$(iwctl station "$WLAN_DEV" get-networks \
    | fzf --header-lines=4                        \
          --color='fg:#bbbbbb'                    \
          --header-first --ellipsis=" "           \
    | awk '{gsub("^ +> +",""); $NF=$(NF-1)=""; gsub(" +$",""); print }' )"
  [[ -z "$ESSID" ]] && return 1

  # run0 ip address flush dev "$WLAN_DEV"
  # run0 ip route   flush dev "$WLAN_DEV"
  iwctl station "$WLAN_DEV" disconnect
  iwctl station "$WLAN_DEV" connect "$ESSID"

  sleep 1
